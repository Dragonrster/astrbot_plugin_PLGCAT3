{
  "rcon_host": {
    "description": "MC 服务器 RCON 地址",
    "type": "string",
    "default": "localhost",
    "hint": "例如 127.0.0.1 或 mc.example.com"
  },
  "rcon_port": {
    "description": "RCON 端口号",
    "type": "int",
    "default": 25575
  },
  "rcon_password": {
    "description": "RCON 密码",
    "type": "string",
    "default": ""
  },
  "mc_server_port": {
    "description": "MC 游戏端口（Server List Ping 用）",
    "type": "int",
    "default": 25565,
    "hint": "与 server.properties 中 server-port 一致"
  },
  "admin_qqs": {
    "description": "管理员 QQ 号列表",
    "type": "list",
    "items": {
      "type": "string"
    },
    "default": [],
    "hint": "列表内的 QQ 可使用所有敏感命令"
  },
  "mcrun_blocked_extra": {
    "description": "/mcrun 追加拦截词",
    "type": "list",
    "items": {
      "type": "string"
    },
    "default": [],
    "hint": "默认已拦截 stop、restart、op、deop、reload"
  },
  "whitelist_command": {
    "description": "白名单命令名",
    "type": "string",
    "default": "whitelist",
    "hint": "原版 whitelist，可改成 swl 等白名单插件"
  },
  "enable_apply_whitelist": {
    "description": "允许玩家自助申请白名单",
    "type": "bool",
    "default": false
  },
  "whitelist_verify_mode": {
    "description": "白名单绑定验证方式",
    "type": "string",
    "default": "code",
    "hint": "none=直接绑定, online=要求在线, code=游戏内验证码"
  },
  "mc_chat_log_to_qq_enabled": {
    "description": "开启 MC→QQ 聊天转发",
    "type": "bool",
    "default": false
  },
  "mc_chat_source": {
    "description": "聊天消息来源",
    "type": "string",
    "default": "file",
    "hint": "file=本地日志文件, mcsm=MCSM 面板 API"
  },
  "mc_chat_log_path": {
    "description": "[file] latest.log 绝对路径",
    "type": "string",
    "default": "",
    "hint": "mc_chat_source=file 时必填"
  },
  "mc_chat_log_tail_from_end": {
    "description": "[file] 启动时从日志末尾开始读",
    "type": "bool",
    "default": true,
    "hint": "避免历史聊天一次性转发"
  },
  "mcsm_panel_url": {
    "description": "[mcsm] 面板地址",
    "type": "string",
    "default": "http://localhost:23333",
    "hint": "mc_chat_source=mcsm 时必填"
  },
  "mcsm_api_key": {
    "description": "[mcsm] API Key",
    "type": "string",
    "default": "",
    "hint": "面板设置 → API 接口"
  },
  "mcsm_instance_uuid": {
    "description": "[mcsm] 实例 UUID",
    "type": "string",
    "default": "",
    "hint": "实例设置页面 URL 中可见"
  },
  "mcsm_daemon_uuid": {
    "description": "[mcsm] 守护进程 UUID",
    "type": "string",
    "default": "",
    "hint": "节点管理页面可见"
  },
  "mc_chat_trigger_prefix": {
    "description": "游戏内触发前缀",
    "type": "string",
    "default": ".mcsay ",
    "hint": "紧跟在 <玩家名> 后，匹配后才转发"
  },
  "mc_chat_unified_msg_origin": {
    "description": "转发目标会话 ID",
    "type": "string",
    "default": "",
    "hint": "留空可用 /mcbindchat 命令写入"
  },
  "mc_chat_qq_group_id": {
    "description": "QQ 群号（备选）",
    "type": "string",
    "default": "",
    "hint": "unified_msg_origin 为空时使用"
  },
  "mc_chat_qq_platform": {
    "description": "平台名",
    "type": "string",
    "default": "aiocqhttp",
    "hint": "一般无需修改"
  },
  "enable_sign": {
    "description": "开启每日签到",
    "type": "bool",
    "default": false
  },
  "sign_money_min": {
    "description": "奖池随机最低值",
    "type": "int",
    "default": 10
  },
  "sign_money_max": {
    "description": "奖池随机最高值",
    "type": "int",
    "default": 100
  },
  "sign_money_command": {
    "description": "加钱 RCON 命令模板",
    "type": "string",
    "default": "d money add {name} {amount}",
    "hint": "EssentialsX 用: eco give {name} {amount}"
  },
  "money_command_prefix": {
    "description": "铜钱命令前缀",
    "type": "string",
    "default": "d money",
    "hint": "查询拼接为: {prefix} get {name}"
  },
  "sign_backfill_cost_per_day": {
    "description": "补签基础费用（铜钱/天）",
    "type": "int",
    "default": 50,
    "hint": "越早越贵：第N天前 = 基础 × 2^(N-1)"
  },
  "sign_day_bonus": {
    "description": "签到累计天数加成（每累计签到一天额外加多少铜钱，封顶5000）",
    "type": "int",
    "default": 20
  },
  "sign_streak_bonus": {
    "description": "连续签到固定加成（每连续一天额外加多少铜钱）",
    "type": "int",
    "default": 20
  },
  "mc_stats_world_path": {
    "description": "服务器 world 目录路径",
    "type": "string",
    "default": "",
    "hint": "留空通过 MCSM 读取。例如 /mc_server/world"
  },
  "sign_cal_font_path": {
    "description": "签到日历自定义字体路径",
    "type": "string",
    "default": "",
    "hint": "留空自动检测系统字体"
  }
}